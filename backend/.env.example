# ============================================
# StockVerse AI - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stockverse?retryWrites=true&w=majority

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (generate a random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# Python ML Service URL (local dev or deployed)
ML_SERVICE_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
